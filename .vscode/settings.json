{
  // ── Existing settings (unchanged) ──────────────────────────────────────
  "files.autoSave": "afterDelay",
  "editor.fontFamily": "JetBrains Mono",
  "editor.wordWrap": "on",
  "extensions.autoCheckUpdates": false,
  "update.mode": "none",
  "editor.fontSize": 13,
  "workbench.activityBar.location": "top",
  "editor.minimap.size": "fit",
  "workbench.colorTheme": "Tokyo Night",

  // ── Font & Rendering ────────────────────────────────────────────────────
  "editor.fontLigatures": true,               // JetBrains Mono has great ligatures
  "editor.fontWeight": "400",
  "editor.lineHeight": 1.7,
  "editor.letterSpacing": 0.3,
  "editor.renderWhitespace": "trailing",      // catch accidental trailing spaces
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",

  // ── Formatting ──────────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,              // avoid surprise reformats on paste
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // ── Code Actions on Save ────────────────────────────────────────────────
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",       // auto-fix ESLint issues on save
    "source.organizeImports": "never"         // let Biome/Prettier handle imports
  },

  // ── TypeScript ──────────────────────────────────────────────────────────
  "typescript.preferences.importModuleSpecifier": "shortest",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.variableTypes.enabled": false,  // too noisy
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,

  // ── IntelliSense & Autocomplete ─────────────────────────────────────────
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnCommitCharacter": false, // avoid accidental accepts
  "editor.quickSuggestionsDelay": 50,
  "editor.tabCompletion": "on",
  "editor.inlineSuggest.enabled": true,

  // ── Editor UI ───────────────────────────────────────────────────────────
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",    // highlight only the active pair
  "editor.guides.indentation": true,
  "editor.stickyScroll.enabled": true,       // pins class/function context at top
  "editor.linkedEditing": true,              // rename HTML open/close tags together
  "editor.occurrencesHighlight": "singleFile",
  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": false,  // blocks look cleaner than characters

  // ── Tabs & Indentation ──────────────────────────────────────────────────
  "editor.tabSize": 2,
  "editor.detectIndentation": false,         // always use tabSize, not file-guessed
  "editor.insertSpaces": true,
  "files.eol": "\n",                         // LF everywhere (matches Prettier config)
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // ── Explorer ────────────────────────────────────────────────────────────
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.astro":       "${capture}.test.ts, ${capture}.test.tsx",
    "*.tsx":         "${capture}.test.tsx, ${capture}.stories.tsx",
    "*.ts":          "${capture}.test.ts, ${capture}.d.ts",
    "package.json":  "package-lock.json, pnpm-lock.yaml, .npmrc, .nvmrc, pnpm-workspace.yaml",
    "astro.config.*": "tsconfig.json, tailwind.config.*",
    ".env":          ".env.*, .env.example",
    "biome.json":    ".prettierrc*, .eslintrc*, eslint.config.*",
    ".editorconfig": ".prettierignore, .gitignore, .gitattributes"
  },
  "explorer.sortOrder": "type",
  "explorer.compactFolders": false,          // always show full folder tree

  // ── Search ──────────────────────────────────────────────────────────────
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.astro": true,
    "**/pnpm-lock.yaml": true
  },

  // ── Git ─────────────────────────────────────────────────────────────────
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,             // stage all if nothing staged
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.currentLine.enabled": true,

  // ── Terminal ────────────────────────────────────────────────────────────
  "terminal.integrated.fontFamily": "JetBrains Mono",
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.cursorBlinking": true,

  // ── Workbench ───────────────────────────────────────────────────────────
  "workbench.editor.labelFormat": "short",
  "workbench.editor.tabSizing": "shrink",
  "workbench.tree.indent": 14,
  "workbench.list.smoothScrolling": true,
  "breadcrumbs.enabled": true,

  // ── Tailwind ────────────────────────────────────────────────────────────
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  "tailwindCSS.validate": true,
  "tailwindCSS.includeLanguages": {
    "astro": "html"
  },

  // ── ESLint ──────────────────────────────────────────────────────────────
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "astro"],
  "eslint.run": "onType",

  // ── Biome ───────────────────────────────────────────────────────────────
  "biome.lspBin": "./node_modules/@biomejs/biome/bin/biome",

  // ── Misc ────────────────────────────────────────────────────────────────
  "security.workspace.trust.untrustedFiles": "open",
  "editor.accessibilitySupport": "off"       // disables accessibility mode overhead
}
