---
interface Props {
  id: string
  title: string
}

const { id, title } = Astro.props
const watchUrl = `https://www.youtube.com/watch?v=${id}`
const thumbnail = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`
---

<div class="youtube-facade not-prose my-8" data-video-id={id} data-video-title={title}>
  <div class="relative aspect-video overflow-hidden rounded-xl bg-black">
    <button
      type="button"
      class="youtube-facade-play group absolute inset-0 h-full w-full"
      aria-label={`Play video: ${title}`}
    >
      <img
        src={thumbnail}
        alt=""
        loading="lazy"
        width="480"
        height="360"
        class="h-full w-full object-cover"
      />
      <span class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors group-hover:bg-black/30">
        <span class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-lg transition-transform group-hover:scale-110">
          <svg xmlns="http://www.w3.org/2000/svg" class="ml-0.5 h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
      </span>
    </button>
  </div>
  <p class="mt-2 text-sm text-muted-foreground">
    <a href={watchUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
      Watch on YouTube
    </a>
  </p>
</div>

<script>
  function initFacades() {
    document.querySelectorAll<HTMLElement>('.youtube-facade').forEach(facade => {
      if (facade.dataset.ready) return
      facade.dataset.ready = 'true'

      const button = facade.querySelector<HTMLButtonElement>('.youtube-facade-play')
      const box = button?.parentElement

      button?.addEventListener('click', () => {
        const iframe = document.createElement('iframe')
        iframe.src = `https://www.youtube-nocookie.com/embed/${facade.dataset.videoId}?autoplay=1&rel=0`
        iframe.title = facade.dataset.videoTitle ?? 'YouTube video player'
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen; web-share'
        iframe.allowFullscreen = true
        iframe.referrerPolicy = 'strict-origin-when-cross-origin'
        iframe.className = 'absolute inset-0 h-full w-full'
        box?.replaceChildren(iframe)
      })
    })
  }

  // Runs on first load and after every ClientRouter navigation
  document.addEventListener('astro:page-load', initFacades)
</script>