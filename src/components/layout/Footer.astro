---
const footerLinks = {
  quickLinks: [
    { label: 'About Us', href: '/about-us' },
    { label: 'Our Programmes', href: '/#donation-programmes' },
    { label: 'Impact', href: '/#impact-metrics' },
    { label: 'Gallery', href: '/#gallery' }
  ],
  getInvolved: [
    { label: 'Donate Now', href: '/donate' },
    { label: 'Become a Volunteer', href: '/#volunteer-impact' },
    { label: 'Corporate Partnerships', href: '/#ways-to-help' },
    { label: 'Fundraise for Us', href: '/#ways-to-help' }
  ],
  legal: [
    { label: 'Privacy Policy', href: '#' },
    { label: 'Terms of Service', href: '#' },
    { label: 'Contact Us', href: '/contact-us' }
  ]
};

const socials = [
  { label: 'Facebook', href: '#' },
  { label: 'Twitter', href: '#' },
  { label: 'Instagram', href: '#' },
  { label: 'LinkedIn', href: '#' }
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-background pt-16 pb-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 grid grid-cols-1 gap-12 lg:grid-cols-12">
      <!-- Brand -->
      <div class="flex flex-col gap-6 lg:col-span-5">
        <a
          href="/"
          class="focus-visible:ring-primary flex items-center gap-3 rounded-sm focus:outline-none focus-visible:ring-2"
          aria-label="MabEcare Foundation home"
        >
          <img
            src="/images/site-logo.webp"
            alt="MabEcare Foundation Logo"
            loading="lazy"
            decoding="async"
            width="32"
            height="32"
            class="h-12 w-auto"
          />

          <div class="flex flex-col leading-none">
            <span class="text-sm font-bold uppercase">
              MabEcare
            </span>

            <span class="text-primary text-xs uppercase">
              Foundation
            </span>
          </div>
        </a>

        <p class="text-muted-foreground max-w-sm">
          Empowering mothers, protecting children, and building stronger communities.
        </p>

        <!-- Newsletter -->
        <form
          class="bg-muted/50 flex items-center rounded-full p-1"
          method="post"
        >
          <label for="footer-email" class="sr-only">
            Email address
          </label>

          <input
            id="footer-email"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="Enter your email"
            class="flex-1 bg-transparent px-4 py-2 outline-none"
          />

          <button
            type="submit"
            class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-full px-4 py-2 text-sm font-medium transition-colors"
          >
            Subscribe
          </button>
        </form>
      </div>

      <!-- Links -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7">
        <nav class="flex flex-col gap-4" aria-label="Quick links">
          <h4 class="text-foreground text-sm font-semibold tracking-wider uppercase">
            Quick Links
          </h4>

          {
            footerLinks.quickLinks.map((link) => (
              <a
                href={link.href}
                class="text-muted-foreground hover:text-primary focus-visible:ring-primary rounded-sm text-sm transition-colors focus:outline-none focus-visible:ring-2"
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <nav class="flex flex-col gap-4" aria-label="Get involved">
          <h4 class="text-foreground text-sm font-semibold tracking-wider uppercase">
            Get Involved
          </h4>

          {
            footerLinks.getInvolved.map((link) => (
              <a
                href={link.href}
                class="text-muted-foreground hover:text-primary focus-visible:ring-primary rounded-sm text-sm transition-colors focus:outline-none focus-visible:ring-2"
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <nav
          class="col-span-2 flex flex-col gap-4 sm:col-span-1"
          aria-label="Legal"
        >
          <h4 class="text-foreground text-sm font-semibold tracking-wider uppercase">
            Legal & Policy
          </h4>

          {
            footerLinks.legal.map((link) => (
              <a
                href={link.href}
                class="text-muted-foreground hover:text-primary focus-visible:ring-primary rounded-sm text-sm transition-colors focus:outline-none focus-visible:ring-2"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>

    <div class="bg-border/50 h-px w-full"></div>

    <!-- Bottom -->
    <div class="mt-8 flex flex-col items-center justify-between gap-6 sm:flex-row">
      <div class="text-center sm:text-left">
        <p class="text-muted-foreground text-sm">
          © {currentYear} MabEcare Foundation. All Rights Reserved.
        </p>

        <p class="text-muted-foreground/50 mt-1 text-xs">
          Site by{' '}
          <a
            href="https://samuel-dorkey.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-muted-foreground transition-colors"
          >
            Sloane Dev
          </a>
        </p>
      </div>

      <!-- Social links -->
      <div class="flex items-center gap-4">
        {
          socials.map((social) => (
            <a
              href={social.href}
              aria-label={social.label}
              class="text-muted-foreground hover:text-primary rounded-full p-2 transition-colors"
            >
              {
                social.label === 'Facebook' && (
                  <svg
                    class="size-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                  </svg>
                )
              }

              {
                social.label === 'Twitter' && (
                  <svg
                    class="size-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231z" />
                  </svg>
                )
              }

              {
                social.label === 'Instagram' && (
                  <svg
                    class="size-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                  </svg>
                )
              }

              {
                social.label === 'LinkedIn' && (
                  <svg
                    class="size-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                    <rect x="2" y="9" width="4" height="12" />
                    <circle cx="4" cy="4" r="2" />
                  </svg>
                )
              }
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>