---
import ThemeToggle from '@/components/layout/theme-toggle';

const pathname = Astro.url.pathname;
const hash = Astro.url.hash;

const navLinks = [
  { label: 'Home', href: '/', match: () => pathname === '/' },
  { label: 'About Us', href: '/about-us', match: () => pathname === '/about-us' },
  { label: 'Programmes', href: '/#donation-programmes', match: () => pathname === '/' && hash === '#donation-programmes' },
  { label: 'Impact', href: '/#impact-metrics', match: () => pathname === '/' && hash === '#impact-metrics' },
  { label: 'Blog', href: '/blog', match: () => pathname === '/blog' || pathname.startsWith('/blog/') },
  { label: 'Videos', href: '/videos', match: () => pathname === '/videos' },
  { label: 'Contact', href: '/contact-us', match: () => pathname === '/contact-us' },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur-md transition-all duration-300"
>
  <div
    id="header-container"
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-8"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-2.5 rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
      aria-label="MabEcare Foundation home"
    >
      <img
        src="/images/site-logo.webp"
        alt="MabEcare Foundation logo"
        class="h-10 w-auto object-contain transition-transform duration-200 hover:scale-105"
        width="40"
        height="40"
      />

      <div class="hidden flex-col leading-none sm:flex">
        <span class="text-sm font-bold tracking-widest text-foreground uppercase">
          MabEcare
        </span>
        <span class="mt-1 text-[10px] font-medium tracking-[0.2em] text-primary uppercase">
          Foundation
        </span>
      </div>
    </a>

    <nav
      class="hidden items-center gap-1 lg:flex"
      aria-label="Main navigation"
    >
      {navLinks.filter((link) => link.label !== 'Home').map((link) => {
        const isActive = link.match();

        return (
          <a
            href={link.href}
            data-nav-link
            data-href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary',
              isActive
                ? 'bg-primary/10 font-semibold text-primary'
                : 'text-muted-foreground hover:bg-accent hover:text-foreground',
            ]}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2.5 sm:gap-3">
      <ThemeToggle client:load />

      <a
        href="/donate"
        aria-label="Donate to MabEcare Foundation"
        class="hidden h-10 items-center gap-2 rounded-full bg-primary px-5 text-sm font-semibold text-primary-foreground shadow-sm transition-all duration-200 hover:bg-primary/90 hover:shadow-md active:scale-[0.98] sm:flex"
      >
        <span>Donate</span>
        <span
          class="flex size-6 items-center justify-center rounded-full bg-primary-foreground/15"
          aria-hidden="true"
        >
          →
        </span>
      </a>

      <button
        type="button"
        id="menu-toggle-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-10 w-10 items-center justify-center rounded-md text-foreground transition-colors hover:bg-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-primary lg:hidden"
      >
        <svg
          id="menu-icon"
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>

        <svg
          id="close-icon"
          class="hidden size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation menu"
  aria-hidden="true"
  class="invisible pointer-events-none fixed inset-x-0 top-16 z-40 flex -translate-y-2 flex-col border-b border-border bg-background/98 px-6 pb-8 pt-4 opacity-0 backdrop-blur-xl transition-all duration-300 ease-out lg:hidden"
>
  <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
    {navLinks.map((link) => {
      const isActive = link.match();

      return (
        <a
          href={link.href}
          data-nav-link
          data-href={link.href}
          data-mobile-link
          aria-current={isActive ? 'page' : undefined}
          class:list={[
            'rounded-md px-4 py-3 text-lg font-medium transition-colors duration-150',
            isActive
              ? 'bg-primary/10 font-semibold text-primary'
              : 'text-foreground hover:bg-accent hover:text-primary',
          ]}
        >
          {link.label}
        </a>
      );
    })}
  </nav>

  <div class="mt-6 border-t border-border pt-5">
    <a
      href="/donate"
      data-mobile-close
      class="flex h-12 w-full items-center justify-center gap-2.5 rounded-full bg-primary px-6 text-base font-semibold text-primary-foreground shadow-sm transition-all duration-200 hover:bg-primary/90 hover:shadow-md active:scale-[0.98]"
    >
      <span>Donate Now</span>
      <span
        class="flex size-7 items-center justify-center rounded-full bg-primary-foreground/15"
        aria-hidden="true"
      >
        →
      </span>
    </a>
  </div>
</div>

<script>
  const siteHeader = document.getElementById('site-header');
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  const navLinks =
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  let mobileOpen = false;

  const handleScroll = () => {
    if (!siteHeader) return;

    siteHeader.classList.toggle('shadow-sm', window.scrollY > 20);
    siteHeader.classList.toggle('border-border/80', window.scrollY > 20);
    siteHeader.classList.toggle('border-border/40', window.scrollY <= 20);
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  const setMobileMenuState = (open: boolean) => {
    if (!mobileMenu || !toggleBtn) return;

    mobileOpen = open;

    mobileMenu.classList.toggle('invisible', !open);
    mobileMenu.classList.toggle('pointer-events-none', !open);
    mobileMenu.classList.toggle('opacity-0', !open);
    mobileMenu.classList.toggle('-translate-y-2', !open);

    mobileMenu.classList.toggle('visible', open);
    mobileMenu.classList.toggle('pointer-events-auto', open);
    mobileMenu.classList.toggle('opacity-100', open);
    mobileMenu.classList.toggle('translate-y-0', open);

    menuIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);

    mobileMenu.setAttribute('aria-hidden', String(!open));
    toggleBtn.setAttribute('aria-expanded', String(open));
    toggleBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');

    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggleBtn?.addEventListener('click', () => {
    setMobileMenuState(!mobileOpen);
  });

  document.querySelectorAll('[data-mobile-link], [data-mobile-close]').forEach((element) => {
    element.addEventListener('click', () => setMobileMenuState(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileOpen) {
      setMobileMenuState(false);
      toggleBtn?.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && mobileOpen) {
      setMobileMenuState(false);
    }
  });

  const hashLinks = Array.from(navLinks).filter((link) =>
    link.dataset.href?.startsWith('/#'),
  );

  const targets = hashLinks
    .map((link) => {
      const id = link.dataset.href?.split('#')[1];
      return id ? document.getElementById(id) : null;
    })
    .filter((element): element is HTMLElement => element !== null);

  const setHashLinkActive = (activeId: string | null) => {
    hashLinks.forEach((link) => {
      const isTarget = link.dataset.href === `/#${activeId}`;

      link.classList.toggle('bg-primary/10', isTarget);
      link.classList.toggle('text-primary', isTarget);
      link.classList.toggle('font-semibold', isTarget);
      link.classList.toggle('text-muted-foreground', !isTarget);
      link.classList.toggle('font-medium', !isTarget);

      if (isTarget) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  if (targets.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting);
        if (visible.length === 0) return;

        const top = visible.reduce((current, entry) =>
          entry.intersectionRatio > current.intersectionRatio ? entry : current,
        );

        setHashLinkActive(top.target.id);
      },
      {
        threshold: [0.1, 0.25, 0.5],
        rootMargin: '-80px 0px -50% 0px',
      },
    );

    targets.forEach((target) => observer.observe(target));
  }

  navLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      const href = link.getAttribute('href');

      if (!href?.startsWith('/#') || window.location.pathname !== '/') return;

      const id = href.split('#')[1];
      const target = id ? document.getElementById(id) : null;

      if (!target) return;

      event.preventDefault();

      target.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });

      history.pushState(null, '', href);
      setHashLinkActive(id);
    });
  });
</script>
