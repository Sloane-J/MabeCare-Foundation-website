---
import ThemeToggle from '@/components/layout/theme-toggle';
import { Button } from '@/components/ui/button';

const pathname = Astro.url.pathname;

const homeNavLinks = [
  { label: 'About Us', href: '/about-us' },
  { label: 'Programmes', href: '#donation-programmes' },
  { label: 'Impact', href: '#impact-metrics' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact-us' }
];

const aboutNavLinks = [
  { label: 'Home', href: '/' },
  { label: 'Programmes', href: '/#donation-programmes' },
  { label: 'Impact', href: '/#impact-metrics' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/#contact-us' }
];

const contactNavLinks = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about-us' },
  { label: 'Programmes', href: '/#donation-programmes' },
  { label: 'Impact', href: '/#impact-metrics' },
  { label: 'Blog', href: '/blog' }
];

const isAbout = pathname === '/about-us';
const isContact = pathname === '/contact-us';

const navLinks = isContact
  ? contactNavLinks
  : isAbout
  ? aboutNavLinks
  : homeNavLinks;

const isLinkActive = (href: string) => {
  if (href === '/about-us') return pathname === '/about-us';
  if (href === '/blog') return pathname.startsWith('/blog');
  if (href === '/') return pathname === '/';
  if (href === '/contact-us') return pathname === '/contact-us';
  return false;
};
---

<header 
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur-md transition-all duration-300"
>
  <div
    id="header-container"
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-8"
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex shrink-0 items-center gap-2.5 rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
      aria-label="MabEcare Foundation home"
    >
      <img
        src="/images/site-logo.webp"
        alt="MabEcare Foundation Logo"
        class="h-10 w-auto object-contain transition-transform duration-200 hover:scale-105"
        width="40"
        height="40"
      />

      <div class="hidden flex-col leading-none sm:flex">
        <span class="text-foreground text-sm font-bold tracking-widest uppercase">
          MabEcare
        </span>

        <span class="text-primary text-[10px] font-medium tracking-[0.2em] uppercase">
          Foundation
        </span>
      </div>
    </a>

    <!-- Desktop navigation -->
    <nav
      class="hidden items-center gap-1 lg:flex"
      aria-label="Main navigation"
    >
      {
        navLinks.map((link) => {
          const isActive = isLinkActive(link.href);
          return (
            <a
              href={link.href}
              data-nav-link
              data-href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={`rounded-md px-3.5 py-2 text-sm font-medium transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary ${
                isActive
                  ? 'bg-primary/10 text-primary font-semibold'
                  : 'text-muted-foreground hover:bg-accent hover:text-foreground'
              }`}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-3">
      <ThemeToggle client:load />

      <Button
        className="hidden rounded-md px-5 py-2 text-sm font-semibold transition-transform duration-150 active:scale-95 sm:flex"
        asChild
      >
        <a href="/donate">Donate</a>
      </Button>

      <button
        type="button"
        id="menu-toggle-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="text-foreground hover:bg-accent flex h-10 w-10 items-center justify-center rounded-md transition-colors lg:hidden"
      >
        <svg
          id="menu-icon"
          class="size-5 transition-transform duration-200"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>

        <svg
          id="close-icon"
          class="hidden size-5 transition-transform duration-200"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation menu"
  class="bg-background/98 pointer-events-none fixed inset-x-0 top-16 z-40 flex flex-col border-b border-border px-6 pb-8 pt-4 backdrop-blur-xl opacity-0 invisible -translate-y-2 transition-all duration-300 ease-out lg:hidden"
>
  <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
    {
      navLinks.map((link) => {
        const isActive = isLinkActive(link.href);
        return (
          <a
            href={link.href}
            data-nav-link
            data-href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class={`rounded-md px-4 py-3 text-lg font-medium transition-colors duration-150 ${
              isActive ? 'bg-primary/10 text-primary font-semibold' : 'text-foreground hover:bg-accent hover:text-primary'
            }`}
          >
            {link.label}
          </a>
        );
      })
    }
  </nav>

  <div class="mt-6 pt-4 border-t border-border">
    <Button
      className="w-full rounded-md py-5 text-base font-semibold transition-transform duration-150 active:scale-98"
      asChild
    >
      <a href="/donate" data-mobile-close>
        Donate Now
      </a>
    </Button>
  </div>
</div>

<script>
  // Dynamic behavior implementation
  const siteHeader = document.getElementById('site-header');
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const mobileCloseTriggers = document.querySelectorAll('[data-mobile-close]');

  let mobileOpen = false;

  // 1. Scroll shadow toggle
  const handleScroll = () => {
    if (window.scrollY > 20) {
      siteHeader?.classList.add('shadow-sm', 'border-border/80');
      siteHeader?.classList.remove('border-border/40');
    } else {
      siteHeader?.classList.remove('shadow-sm', 'border-border/80');
      siteHeader?.classList.add('border-border/40');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // 2. Mobile Menu Toggle Logic
  const setMobileMenuState = (open: boolean) => {
    mobileOpen = open;
    if (open) {
      mobileMenu?.classList.remove('pointer-events-none', 'invisible', 'opacity-0', '-translate-y-2');
      mobileMenu?.classList.add('visible', 'opacity-100', 'translate-y-0');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      toggleBtn?.setAttribute('aria-expanded', 'true');
      toggleBtn?.setAttribute('aria-label', 'Close menu');
    } else {
      mobileMenu?.classList.add('pointer-events-none', 'invisible', 'opacity-0', '-translate-y-2');
      mobileMenu?.classList.remove('visible', 'opacity-100', 'translate-y-0');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
      toggleBtn?.setAttribute('aria-expanded', 'false');
      toggleBtn?.setAttribute('aria-label', 'Open menu');
    }
  };

  toggleBtn?.addEventListener('click', () => setMobileMenuState(!mobileOpen));

  navLinks.forEach(link => {
    link.addEventListener('click', () => setMobileMenuState(false));
  });

  mobileCloseTriggers.forEach(trigger => {
    trigger.addEventListener('click', () => setMobileMenuState(false));
  });

  // 3. Intersection Observer for Hash Scroll Links
  const hashLinks = Array.from(navLinks).filter(link => 
    link.dataset.href?.startsWith('#')
  );

  const targets = hashLinks
    .map(link => {
      const id = link.dataset.href?.slice(1);
      return id ? document.getElementById(id) : null;
    })
    .filter((el): el is HTMLElement => el !== null);

  if (targets.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting);
        if (visible.length === 0) return;

        const top = visible.reduce((current, entry) =>
          entry.intersectionRatio > current.intersectionRatio ? entry : current
        );

        const activeId = `#${top.target.id}`;

        hashLinks.forEach(link => {
          const isTarget = link.dataset.href === activeId;
          if (isTarget) {
            link.setAttribute('aria-current', 'page');
            if (link.classList.contains('text-lg')) {
              link.className = 'rounded-md px-4 py-3 text-lg font-semibold transition-colors duration-150 bg-primary/10 text-primary';
            } else {
              link.className = 'rounded-md px-3.5 py-2 text-sm font-semibold transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary bg-primary/10 text-primary';
            }
          } else if (!link.dataset.href?.startsWith('/')) {
            link.removeAttribute('aria-current');
            if (link.classList.contains('text-lg')) {
              link.className = 'rounded-md px-4 py-3 text-lg font-medium transition-colors duration-150 text-foreground hover:bg-accent hover:text-primary';
            } else {
              link.className = 'rounded-md px-3.5 py-2 text-sm font-medium transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary text-muted-foreground hover:bg-accent hover:text-foreground';
            }
          }
        });
      },
      {
        threshold: [0.1, 0.5],
        rootMargin: '-64px 0px -50% 0px',
      }
    );

    targets.forEach(target => observer.observe(target));
  }
</script>