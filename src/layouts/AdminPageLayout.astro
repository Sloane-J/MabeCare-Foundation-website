---
interface Props {
  title: string
}
const { title } = Astro.props

import "@/styles/global.css";

import '@fontsource/outfit/100.css'
import '@fontsource/outfit/300.css'
import '@fontsource/outfit/400.css'
import '@fontsource/outfit/500.css'
import '@fontsource/outfit/600.css'
import '@fontsource/outfit/700.css'
import '@fontsource/outfit/800.css'
import '@fontsource/outfit/900.css'
import '@fontsource/merriweather/300.css'
import '@fontsource/merriweather/400.css'
import '@fontsource/merriweather/700.css'
import '@fontsource/merriweather/900.css'
import '@fontsource/geist-mono/400.css'
import '@fontsource/geist-mono/500.css'
import '@fontsource/geist-mono/600.css'
import '@fontsource/kaushan-script/400.css'
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} - MabEcare Admin</title>

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicon/android-chrome-192x192.png" sizes="192x192" />
    <link rel="icon" type="image/png" href="/favicon/android-chrome-512x512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" sizes="180x180" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="manifest" href="/admin-manifest.json" />
    <meta name="theme-color" content="#6A1B9A" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="MabEcare Admin" />

    <style>
      /* ── Reset ── */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      /* ── Base ── */
      :root {
        --font-sans:  'Outfit', system-ui, -apple-system, sans-serif;
        --font-serif: 'Merriweather', Georgia, serif;
        --font-mono:  'Geist Mono', 'Fira Code', monospace;

        --color-bg:        #F9F9FA;
        --color-surface:   #FFFFFF;
        --color-border:    #EAEAEA;
        --color-border-md: #D6D6D6;

        --color-text-primary:   #1A1A1A;
        --color-text-secondary: #666666;
        --color-text-muted:     #8A8A8A;

        --color-accent:        #6A1B9A;
        --color-accent-light:  #EDE7F6;
        --color-accent-hover:  #4A148C;

        --radius-sm: 6px;
        --radius-md: 8px;
        --radius-lg: 12px;
        --radius-xl: 16px;
      }

      html {
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      body {
        font-family: var(--font-sans);
        font-size: 0.875rem;      /* 14px — matches Navan body */
        font-weight: 400;
        line-height: 1.6;
        color: var(--color-text-primary);
        background-color: var(--color-bg);
        min-height: 100svh;
      }

      /* ── Typography scale (matching reference) ── */

      /* Page titles — Merriweather, used sparingly */
      h1 {
        font-family: var(--font-serif);
        font-size: 1.375rem;      /* 22px */
        font-weight: 900;
        letter-spacing: -0.02em;
        line-height: 1.2;
        color: var(--color-text-primary);
      }

      /* Section headings — Outfit semibold */
      h2 {
        font-family: var(--font-sans);
        font-size: 1rem;          /* 16px */
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.3;
        color: var(--color-text-primary);
      }

      /* Card / widget headings */
      h3 {
        font-family: var(--font-sans);
        font-size: 0.8125rem;     /* 13px */
        font-weight: 600;
        letter-spacing: 0;
        line-height: 1.3;
        color: var(--color-text-primary);
      }

      /* Subtext */
      p {
        font-family: var(--font-sans);
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        line-height: 1.6;
      }

      /* Uppercase labels (stat card labels, column headers) */
      .label-xs {
        font-family: var(--font-sans);
        font-size: 0.6875rem;     /* 11px */
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-text-muted);
      }

      /* Metric numbers */
      .metric {
        font-family: var(--font-sans);
        font-size: 1.5rem;        /* 24px */
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1;
        color: var(--color-text-primary);
      }

      .metric-lg {
        font-family: var(--font-sans);
        font-size: 2rem;          /* 32px */
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1;
        color: var(--color-text-primary);
      }

      /* Monospace — amounts, codes */
      .mono {
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
      }

      /* Links */
      a {
        color: var(--color-accent);
        text-decoration: none;
        font-weight: 500;
      }
      a:hover { color: var(--color-accent-hover); text-decoration: underline; }

      /* ── Shared surface styles (consumed by React components via inline + className) ── */

      .card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
      }

      .card-pad { padding: 20px 24px; }

      /* ── Scrollbar ── */
      ::-webkit-scrollbar { width: 6px; height: 6px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: var(--color-border-md); border-radius: 3px; }
      ::-webkit-scrollbar-thumb:hover { background: #BDBDBD; }

      /* ── Focus visible (keyboard nav) ── */
      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
        border-radius: var(--radius-sm);
      }

      /* ── Reduce motion ── */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
  <slot />

  <!-- PWA Install Banner -->
  <div id="pwa-install-bar" style="
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: #6A1B9A;
    color: #fff;
    padding: 10px 16px;
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  ">
    <span style="font-weight: 500;">Install MabEcare Admin for quick access</span>
    <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
      <button id="pwa-install-btn" style="
        background: #fff;
        color: #6A1B9A;
        border: none;
        border-radius: 6px;
        padding: 5px 12px;
        font-family: 'Outfit', sans-serif;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
      ">Install</button>
      <button id="pwa-dismiss-btn" style="
        background: none;
        border: none;
        color: rgba(255,255,255,0.7);
        cursor: pointer;
        font-size: 18px;
        line-height: 1;
        padding: 0 4px;
      " aria-label="Dismiss">&#x2715;</button>
    </div>
  </div>

  <script>
    const bar = document.getElementById('pwa-install-bar') as HTMLDivElement
    const installBtn = document.getElementById('pwa-install-btn') as HTMLButtonElement
    const dismissBtn = document.getElementById('pwa-dismiss-btn') as HTMLButtonElement
    let deferredPrompt: any = null

    if (!sessionStorage.getItem('pwa-dismissed')) {
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault()
        deferredPrompt = e
        bar.style.display = 'flex'
      })
    }

    installBtn?.addEventListener('click', async () => {
      if (!deferredPrompt) return
      deferredPrompt.prompt()
      const { outcome } = await deferredPrompt.userChoice
      bar.style.display = 'none'
      deferredPrompt = null
    })

    dismissBtn?.addEventListener('click', () => {
      bar.style.display = 'none'
      sessionStorage.setItem('pwa-dismissed', '1')
    })

    window.addEventListener('appinstalled', () => {
      bar.style.display = 'none'
      deferredPrompt = null
    })
  </script>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker
          .register('/admin-sw.js', { scope: '/admin/' })
          .catch(err => console.error('SW registration failed:', err))
      })
    }
  </script>
</body>
</html>
