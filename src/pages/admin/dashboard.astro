---
export const prerender = false
import { requireAuth } from '../../lib/auth/session'
import AdminPageLayout from '../../layouts/AdminPageLayout.astro'
import AdminLayout from '../../components/blocks/admin/AdminLayout'
import AdminDashboard from '../../components/blocks/admin/AdminDashboard'

await requireAuth(Astro.cookies)
const currentPath = Astro.url.pathname
---

<AdminPageLayout title="Dashboard — MabEcare Admin">
  <AdminLayout currentPath={currentPath} client:load>
    <AdminDashboard client:load />
  </AdminLayout>
</AdminPageLayout>
