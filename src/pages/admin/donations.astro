---
export const prerender = false
import { requireAuth } from '../../lib/auth/session'
import AdminLayout from '../../components/blocks/admin/AdminLayout'
import DonationsList from '../../components/blocks/admin/DonationsList'

await requireAuth(Astro.cookies)
const currentPath = Astro.url.pathname
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Donations — MabEcare Admin</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="bg-background text-foreground">
    <AdminLayout currentPath={currentPath} client:load>
      <DonationsList client:load />
    </AdminLayout>
  </body>
</html>
