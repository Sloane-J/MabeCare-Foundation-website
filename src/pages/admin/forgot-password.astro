---
export const prerender = false
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Forgot Password — MabEcare Admin</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="bg-background text-foreground min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-sm">
      <div class="mb-8 text-center">
        <div class="mx-auto mb-4 h-10 w-10 rounded-full bg-primary"></div>
        <h1 class="text-2xl font-semibold">Forgot Password</h1>
        <p class="mt-1 text-sm text-muted-foreground">Enter your admin email to receive a reset link</p>
      </div>

      <form id="forgot-form" class="space-y-4">
        <div class="space-y-1.5">
          <label for="email" class="text-sm font-medium">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full rounded-lg border border-border bg-input px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-ring"
            placeholder="admin@mabecare-foundation.org"
          />
        </div>

        <div id="success-msg" class="hidden rounded-lg bg-green-100 px-3 py-2 text-sm text-green-800"></div>
        <div id="error-msg" class="hidden rounded-lg bg-destructive/10 px-3 py-2 text-sm text-destructive"></div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90 disabled:opacity-60"
        >
          Send Reset Link
        </button>

        <a href="/admin" class="block text-center text-sm text-muted-foreground hover:text-foreground">
          Back to login
        </a>
      </form>
    </div>

    <script>
      const form = document.getElementById('forgot-form') as HTMLFormElement
      const successMsg = document.getElementById('success-msg') as HTMLDivElement
      const errorMsg = document.getElementById('error-msg') as HTMLDivElement
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement

      form.addEventListener('submit', async (e) => {
        e.preventDefault()
        successMsg.classList.add('hidden')
        errorMsg.classList.add('hidden')
        submitBtn.disabled = true
        submitBtn.textContent = 'Sending...'

        const email = (document.getElementById('email') as HTMLInputElement).value

        try {
          const res = await fetch('/api/auth/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          })

          if (res.ok) {
            successMsg.textContent = 'If that email exists, a reset link has been sent.'
            successMsg.classList.remove('hidden')
            form.reset()
          } else {
            const data = await res.json()
            errorMsg.textContent = data.error ?? 'Something went wrong'
            errorMsg.classList.remove('hidden')
          }
        } catch {
          errorMsg.textContent = 'Something went wrong. Please try again.'
          errorMsg.classList.remove('hidden')
        } finally {
          submitBtn.disabled = false
          submitBtn.textContent = 'Send Reset Link'
        }
      })
    </script>
  </body>
</html>