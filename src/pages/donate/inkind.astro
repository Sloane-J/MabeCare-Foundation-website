---
export const prerender = true
import Layout from '../../layouts/Layout.astro'
---

<Layout
  title="Donate Items — MabEcare Foundation"
  description="Send physical goods, supplies, or equipment to support MabEcare Foundation's programmes."
>
  <main class="min-h-screen bg-background px-4 py-16">
    <div class="mx-auto max-w-lg">

      <!-- Header -->
      <div class="mb-10">

  <a
    href="/donate"
    class="mb-6 inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m7-7l-7 7 7 7" />
    </svg>
    Back to Donate
  </a>

  <h1 class="text-2xl font-bold lg:text-3xl">Donate Items</h1>
  <p class="mt-2 text-sm text-muted-foreground">
    Fill out the form below and our team will follow up with shipping details. You'll receive a confirmation email once your items arrive.
  </p>
</div>

      <!-- Form -->
      <div class="space-y-5" id="inkind-form">

        <!-- Donor Name -->
        <div class="space-y-1.5">
          <label for="donor-name" class="text-sm font-medium">
            Full Name <span class="text-primary">*</span>
          </label>
          <input
            id="donor-name"
            type="text"
            required
            placeholder="Your full name"
            class="w-full rounded-xl border border-border bg-card px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-ring"
          />
        </div>

        <!-- Email -->
        <div class="space-y-1.5">
          <label for="donor-email" class="text-sm font-medium">
            Email Address <span class="text-primary">*</span>
          </label>
          <input
            id="donor-email"
            type="email"
            required
            placeholder="you@example.com"
            class="w-full rounded-xl border border-border bg-card px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-ring"
          />
          <p class="text-xs text-muted-foreground">
            We'll send a confirmation here when your items arrive.
          </p>
        </div>

        <!-- Country -->
        <div class="space-y-1.5">
          <label for="country" class="text-sm font-medium">Country / Location</label>
          <input
            id="country"
            type="text"
            placeholder="Where are you sending from?"
            class="w-full rounded-xl border border-border bg-card px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-ring"
          />
        </div>

        <!-- Item Description -->
        <div class="space-y-1.5">
          <label for="item-description" class="text-sm font-medium">
            Item Description <span class="text-primary">*</span>
          </label>
          <textarea
            id="item-description"
            required
            rows="4"
            placeholder="Describe the items you're donating — type, quantity, condition..."
            class="w-full rounded-xl border border-border bg-card px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-ring resize-none"
          ></textarea>
        </div>

        <!-- Estimated Value -->
        <div class="space-y-1.5">
          <label for="estimated-value" class="text-sm font-medium">
            Estimated Value (GHS)
          </label>
          <input
            id="estimated-value"
            type="number"
            min="0"
            step="0.01"
            placeholder="Optional"
            class="w-full rounded-xl border border-border bg-card px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-ring"
          />
        </div>

        <!-- Expected Ship Date -->
        <div class="space-y-1.5">
          <label for="ship-date" class="text-sm font-medium">Expected Shipping Date</label>
          <input
            id="ship-date"
            type="date"
            class="w-full rounded-xl border border-border bg-card px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-ring"
          />
        </div>

        <!-- Photos -->
        <div class="space-y-1.5">
          <label class="text-sm font-medium">Photos</label>
          <div
            id="upload-area"
            class="flex min-h-32 cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-border bg-card px-4 py-6 text-center transition-colors hover:border-primary/40"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-muted-foreground/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-sm text-muted-foreground">Click to upload photos</p>
            <p class="text-xs text-muted-foreground/70">PNG, JPG up to 5MB each</p>
            <input id="photo-input" type="file" accept="image/*" multiple class="hidden" />
          </div>
          <div id="photo-previews" class="grid grid-cols-3 gap-2"></div>
          <p class="text-xs text-muted-foreground">
            Photos will be uploaded after Cloudinary is configured.
          </p>
        </div>

        <!-- Personal Message -->
        <div class="space-y-1.5">
          <label for="message" class="text-sm font-medium">Personal Message</label>
          <textarea
            id="message"
            rows="3"
            placeholder="Optional — share why you're donating these items"
            class="w-full rounded-xl border border-border bg-card px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-ring resize-none"
          ></textarea>
        </div>

        <!-- Error -->
        <div id="form-error" class="hidden rounded-xl bg-destructive/10 px-4 py-3 text-sm text-destructive"></div>

        <!-- Success -->
        <div id="form-success" class="hidden rounded-xl bg-green-100 px-4 py-3 text-sm text-green-800 dark:bg-green-900/30 dark:text-green-400"></div>

        <!-- Submit -->
        <button
          id="submit-btn"
          class="w-full rounded-xl bg-primary px-6 py-3.5 text-sm font-bold text-primary-foreground transition-opacity hover:opacity-90 disabled:opacity-60"
        >
          Submit Donation
        </button>

        <p class="text-center text-xs text-muted-foreground">
          Our team will contact you with shipping instructions after you submit.
        </p>
      </div>
    </div>
  </main>
</Layout>

<script>
  const uploadArea = document.getElementById('upload-area') as HTMLDivElement
  const photoInput = document.getElementById('photo-input') as HTMLInputElement
  const previews = document.getElementById('photo-previews') as HTMLDivElement
  const errorEl = document.getElementById('form-error') as HTMLDivElement
  const successEl = document.getElementById('form-success') as HTMLDivElement
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement

  const CLOUD_NAME = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME
  const UPLOAD_PRESET = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET

  let selectedFiles: File[] = []

  uploadArea.addEventListener('click', () => photoInput.click())

  photoInput.addEventListener('change', () => {
    selectedFiles = Array.from(photoInput.files ?? [])
    previews.innerHTML = ''
    selectedFiles.forEach(file => {
      const url = URL.createObjectURL(file)
      const img = document.createElement('img')
      img.src = url
      img.className = 'aspect-square w-full rounded-lg object-cover'
      previews.appendChild(img)
    })
  })

  async function uploadToCloudinary(file: File): Promise<string> {
    const formData = new FormData()
    formData.append('file', file)
    formData.append('upload_preset', UPLOAD_PRESET)

    const res = await fetch(
      `https://api.cloudinary.com/v1_1/${CLOUD_NAME}/image/upload`,
      { method: 'POST', body: formData }
    )

    if (!res.ok) throw new Error('Photo upload failed')
    const data = await res.json()
    return data.secure_url as string
  }

  submitBtn.addEventListener('click', async () => {
    errorEl.classList.add('hidden')
    successEl.classList.add('hidden')

    const donor_name = (document.getElementById('donor-name') as HTMLInputElement).value.trim()
    const donor_email = (document.getElementById('donor-email') as HTMLInputElement).value.trim()
    const country = (document.getElementById('country') as HTMLInputElement).value.trim()
    const item_description = (document.getElementById('item-description') as HTMLTextAreaElement).value.trim()
    const estimated_value = (document.getElementById('estimated-value') as HTMLInputElement).value
    const expected_ship_date = (document.getElementById('ship-date') as HTMLInputElement).value
    const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim()

    if (!donor_name || !donor_email || !item_description) {
      errorEl.textContent = 'Please fill in all required fields'
      errorEl.classList.remove('hidden')
      return
    }

    submitBtn.disabled = true
    submitBtn.textContent = 'Uploading photos...'

    try {
      // Upload photos first
      const photoUrls: string[] = []
      for (const file of selectedFiles) {
        const url = await uploadToCloudinary(file)
        photoUrls.push(url)
      }

      submitBtn.textContent = 'Submitting...'

      const res = await fetch('/api/inkind/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          donor_name,
          donor_email,
          country: country || undefined,
          item_description,
          estimated_value: estimated_value ? parseFloat(estimated_value) : undefined,
          expected_ship_date: expected_ship_date || undefined,
          message: message || undefined,
          photos: photoUrls,
        }),
      })

      const data = await res.json()
      if (!res.ok) throw new Error(data.error ?? 'Submission failed')

      successEl.textContent = 'Thank you! Your donation has been submitted. We will be in touch with shipping details soon.'
      successEl.classList.remove('hidden')

      // Reset form
      document.querySelectorAll('#inkind-form input, #inkind-form textarea').forEach(el => {
        (el as HTMLInputElement).value = ''
      })
      previews.innerHTML = ''
      selectedFiles = []

      successEl.scrollIntoView({ behavior: 'smooth', block: 'center' })
    } catch (e: any) {
      errorEl.textContent = e.message
      errorEl.classList.remove('hidden')
    } finally {
      submitBtn.disabled = false
      submitBtn.textContent = 'Submit Donation'
    }
  })
</script>
