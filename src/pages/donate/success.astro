---
export const prerender = false
import Layout from '../../layouts/Layout.astro'
---

<Layout title="Thank You — MabEcare Foundation">
  <main class="flex min-h-screen items-center justify-center px-4 py-16">
    <div class="mx-auto w-full max-w-md text-center">

      <!-- Loading state -->
      <div id="loading-state" class="flex flex-col items-center">
        <div class="h-16 w-16 animate-spin rounded-full border-4 border-accent border-t-primary"></div>
        <p class="mt-6 text-sm text-muted-foreground">Confirming your donation…</p>
      </div>

      <!-- Success state -->
      <div id="success-state" class="hidden flex-col items-center">
        <div id="success-icon" class="relative mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-accent">
          <svg
            id="checkmark"
            xmlns="http://www.w3.org/2000/svg"
            class="h-10 w-10 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              id="checkmark-path"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 13l4 4L19 7"
              pathLength="1"
            />
          </svg>
          <!-- Pulse ring -->
          <span id="pulse-ring" class="absolute inset-0 rounded-full border-2 border-primary opacity-0"></span>
        </div>

        <h1 id="success-title" class="text-2xl font-bold opacity-0">Thank you for your donation!</h1>

        <p id="success-message" class="mt-3 text-sm text-muted-foreground opacity-0">
          Your contribution has been received and will go directly toward supporting
          MabEcare Foundation's programmes.
        </p>

        <!-- Donation details card -->
        <div id="details-card" class="mt-6 w-full scale-95 rounded-2xl border border-border bg-card p-5 text-left opacity-0">
          <div class="flex items-center justify-between border-b border-border pb-3">
            <span class="text-xs text-muted-foreground">Amount</span>
            <span id="detail-amount" class="text-lg font-bold text-primary">—</span>
          </div>
          <div class="flex items-center justify-between pt-3">
            <span class="text-xs text-muted-foreground">Reference</span>
            <span id="detail-reference" class="font-mono text-xs text-foreground">—</span>
          </div>
        </div>

        <a
          id="home-btn"
          href="/"
          class="mt-8 inline-block scale-95 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground opacity-0 transition-all hover:opacity-90 hover:scale-105"
        >
          Back to Home
        </a>
      </div>

      <!-- Error state -->
      <div id="error-state" class="hidden flex-col items-center">
        <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-destructive/10">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-destructive" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold">We couldn't confirm this donation</h1>
        <p class="mt-3 text-sm text-muted-foreground">
          We weren't able to verify this transaction. If you completed a payment, please contact us and we'll sort it out.
        </p>
        <a
          href="/donate"
          class="mt-8 inline-block rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
        >
          Try Again
        </a>
      </div>

    </div>
  </main>
</Layout>

<script>
  const loadingState = document.getElementById('loading-state') as HTMLDivElement
  const successState = document.getElementById('success-state') as HTMLDivElement
  const errorState   = document.getElementById('error-state') as HTMLDivElement

  const detailAmount    = document.getElementById('detail-amount') as HTMLSpanElement
  const detailReference = document.getElementById('detail-reference') as HTMLSpanElement

  async function verifyPayment() {
    const params = new URLSearchParams(window.location.search)
    const reference = params.get('reference') || params.get('trxref')

    if (!reference) {
      showError()
      return
    }

    try {
      const res = await fetch(`/api/paystack/verify?reference=${encodeURIComponent(reference)}`)
      const data = await res.json()

      if (!res.ok || data.status !== 'success') {
        showError()
        return
      }

      detailAmount.textContent = `₵${Number(data.amount).toLocaleString('en-GH', { minimumFractionDigits: 2 })}`
      detailReference.textContent = data.reference

      showSuccess()
    } catch {
      showError()
    }
  }

  function showSuccess() {
    loadingState.classList.add('hidden')
    successState.classList.remove('hidden')
    successState.classList.add('flex')

    // Bounce + morph checkmark icon
    const icon = document.getElementById('success-icon') as HTMLDivElement
    const pulseRing = document.getElementById('pulse-ring') as HTMLSpanElement
    const checkmarkPath = document.getElementById('checkmark-path') as SVGPathElement
    const title = document.getElementById('success-title') as HTMLHeadingElement
    const message = document.getElementById('success-message') as HTMLParagraphElement
    const detailsCard = document.getElementById('details-card') as HTMLDivElement
    const homeBtn = document.getElementById('home-btn') as HTMLAnchorElement

    // Icon bounce-in
    icon.animate(
      [
        { transform: 'scale(0)', opacity: 0 },
        { transform: 'scale(1.15)', opacity: 1, offset: 0.6 },
        { transform: 'scale(0.95)', offset: 0.8 },
        { transform: 'scale(1)', opacity: 1 },
      ],
      { duration: 600, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)', fill: 'forwards' }
    )

    // Checkmark draw-in (morph via stroke-dashoffset using pathLength)
    checkmarkPath.style.strokeDasharray = '1'
    checkmarkPath.style.strokeDashoffset = '1'
    checkmarkPath.animate(
      [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }],
      { duration: 450, delay: 250, easing: 'ease-out', fill: 'forwards' }
    )

    // Pulse ring expand + fade
    pulseRing.animate(
      [
        { transform: 'scale(1)', opacity: 0.6 },
        { transform: 'scale(1.6)', opacity: 0 },
      ],
      { duration: 900, delay: 150, easing: 'ease-out', fill: 'forwards' }
    )

    // Staggered fade-up for text + card + button
    const staggerItems = [
      { el: title, delay: 350 },
      { el: message, delay: 450 },
      { el: detailsCard, delay: 550, scale: true },
      { el: homeBtn, delay: 700, scale: true },
    ]

    staggerItems.forEach(({ el, delay, scale }) => {
      el.animate(
        [
          { transform: scale ? 'scale(0.95) translateY(8px)' : 'translateY(8px)', opacity: 0 },
          { transform: scale ? 'scale(1) translateY(0)' : 'translateY(0)', opacity: 1 },
        ],
        { duration: 500, delay, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' }
      )
    })
  }

  function showError() {
    loadingState.classList.add('hidden')
    errorState.classList.remove('hidden')
    errorState.classList.add('flex')
  }

  verifyPayment()
</script>