---
export const prerender = true
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Corporate Partnerships — MabEcare Foundation"
  description="Partner with MabEcare Foundation to support mothers and children in Ghana through corporate giving and collaboration."
>
  <main class="px-4 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl">

      <div class="mb-12 text-center">
        <h1 class="text-3xl font-bold text-foreground sm:text-4xl">Corporate Partnerships</h1>
        <p class="mt-4 text-base text-muted-foreground leading-relaxed">
          Partner with MabEcare Foundation to make a lasting impact on the lives of mothers and children across Ghana.
        </p>
      </div>

      <div class="space-y-8 text-foreground">
        <section>
          <h2 class="text-xl font-bold">Why Partner With Us</h2>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            Businesses and organisations play a vital role in strengthening community health and welfare initiatives. By partnering with MabEcare Foundation, your company can directly support maternal health, child welfare, and community outreach programmes while building a meaningful connection with the communities you serve.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold">Ways to Partner</h2>
          <ul class="mt-3 space-y-2 text-muted-foreground leading-relaxed list-disc pl-5">
            <li>Sponsor a specific programme, such as our blood donation drives or maternal welfare fund</li>
            <li>Provide in-kind donations of goods, supplies, or professional services</li>
            <li>Match employee donations or organise a workplace giving campaign</li>
            <li>Collaborate on community outreach events</li>
            <li>Offer skills-based volunteering from your team</li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-bold">Get in Touch</h2>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            We would love to explore how your organisation can work with MabEcare Foundation. Reach out to us and our team will get back to you to discuss partnership opportunities.
          </p>
        </section>
      </div>

      <div class="mt-10 text-center">
        <a
          href="/contact-us"
          class="inline-block rounded-xl bg-primary px-8 py-3.5 text-sm font-bold text-primary-foreground transition-opacity hover:opacity-90"
        >
          Contact Us About Partnering
        </a>
      </div>

    </div>
  </main>
</Layout>